    {"name": "symbol", "type": "string"},
    {"name": "client_order_id", "type": "string"},
    {"name": "exchange_order_id", "type": ["string", "null"]},
    {"name": "details_json", "type": "string"},
    {"name": "run_id", "type": "string"}
  ]
}
