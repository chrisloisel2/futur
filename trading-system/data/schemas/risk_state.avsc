    {"name": "risk_off_mode", "type": "boolean"},
    {"name": "book_risk_json", "type": "string"},
    {"name": "scenario_results_json", "type": "string"},
    {"name": "caps_applied_json", "type": "string"},
    {"name": "actions_taken_json", "type": "string"},
    {"name": "run_id", "type": "string"}
  ]
}
