{
  "type": "record",
  "name": "SignalSnapshot",
  "namespace": "trading.system",
  "fields": [
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "symbol", "type": "string"},
    {"name": "feature_set", "type": "string"},
    {"name": "model_stack", "type": "string"},
    {"name": "tradeable", "type": "boolean"},
    {"name": "mode", "type": "string"},
    {"name": "direction", "type": "string"},
    {"name": "decision_status", "type": "string"},
    {"name": "coarse_direction", "type": "string"},
    {"name": "regime_entropy", "type": "double"},
    {"name": "confidence_raw", "type": "double"},
    {"name": "confidence_calibrated", "type": "double"},
    {"name": "p_hit", "type": "double"},
    {"name": "expected_shortfall", "type": "double"},
    {"name": "rv_fwd_mean", "type": "double"},
    {"name": "rv_fwd_q50", "type": "double"},
    {"name": "rv_fwd_q95", "type": "double"},
    {"name": "q05", "type": "double"},
    {"name": "q50", "type": "double"},
    {"name": "q95", "type": "double"},
    {"name": "novelty_score", "type": "double"},
    {"name": "disagreement_score", "type": "double"},
    {"name": "quality_flags", "type": "long"},
    {"name": "reasons", "type": "string"},
    {"name": "model_version", "type": "string"},
    {"name": "run_id", "type": "string"},
    {"name": "regime_prob_impulse", "type": "double"},
    {"name": "regime_prob_reversal", "type": "double"},
    {"name": "regime_prob_breakout", "type": "double"},
    {"name": "regime_prob_squeeze", "type": "double"},
    {"name": "regime_prob_calm", "type": "double"},
    {"name": "regime_prob_chop", "type": "double"}
  ]
}
