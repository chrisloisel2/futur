{
  "type": "record",
  "name": "BooksStateSnapshot",
  "namespace": "trading.system",
  "fields": [
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "active_books", "type": {"type": "array", "items": "string"}},
    {"name": "book_a_gross", "type": "double"},
    {"name": "book_a_net", "type": "double"},
    {"name": "book_b_gross", "type": "double"},
    {"name": "book_b_net", "type": "double"},
    {"name": "book_c_gross", "type": "double"},
    {"name": "book_c_net", "type": "double"}
  ]
}
