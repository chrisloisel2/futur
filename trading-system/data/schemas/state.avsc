{
  "type": "record",
  "name": "State",
  "namespace": "trading.system",
  "fields": [
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "symbol", "type": "string"},
    {"name": "position", "type": "double"},
    {"name": "cash", "type": "double"},
    {"name": "equity", "type": "double"},
    {"name": "exposure_gross", "type": "double"},
    {"name": "exposure_net", "type": "double"},
    {"name": "quality_flags", "type": ["long", "null"]},
    {"name": "regime", "type": ["string", "null"]},
    {"name": "feature_set", "type": ["string", "null"]},
    {"name": "label_set", "type": ["string", "null"]}
  ]
}
