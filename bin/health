#!/usr/bin/env bash
# bin/health — Vérification complète du système
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

BOLD='\033[1m'; GRN='\033[0;32m'; YLW='\033[1;33m'; RED='\033[0;31m'; GRY='\033[0;37m'; NC='\033[0m'

OK="${GRN}✓${NC}"; WARN="${YLW}⚠${NC}"; FAIL="${RED}✗${NC}"

echo -e "\n${BOLD}▶ Health Check — Alpha Trading System${NC}  $(date '+%Y-%m-%d %H:%M:%S')\n"

errors=0

# 1. Python
PY=$(python3 --version 2>&1)
echo -e "  $OK  Python   $GRY$PY$NC"

# 2. MongoDB
if python3 -c "import pymongo; pymongo.MongoClient('mongodb://localhost:27017', serverSelectionTimeoutMS=2000).server_info()" 2>/dev/null; then
    echo -e "  $OK  MongoDB  ${GRN}connecté${NC}"
else
    echo -e "  $WARN  MongoDB  ${YLW}non joignable (optionnel pour paper trading)${NC}"
fi

# 3. API FastAPI
API_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 3 http://localhost:8000/health 2>/dev/null || echo "000")
if [ "$API_STATUS" = "200" ]; then
    echo -e "  $OK  API      ${GRN}http://localhost:8000 (200)${NC}"
elif [ "$API_STATUS" = "000" ]; then
    echo -e "  $WARN  API      ${YLW}non démarrée (lancer: ./launch.sh)${NC}"
else
    echo -e "  $FAIL  API      ${RED}erreur HTTP $API_STATUS${NC}"
    ((errors++)) || true
fi

# 4. Données enrichies
ENRICHED="$ROOT/data/enriched"
echo ""
echo -e "  ${BOLD}Données enrichies${NC}  ($ENRICHED)"
if [ ! -d "$ENRICHED" ] || [ -z "$(ls -A "$ENRICHED" 2>/dev/null)" ]; then
    echo -e "    $FAIL  ${RED}Aucun parquet — lancer: bin/bootstrap${NC}"
    ((errors++)) || true
else
    for f in "$ENRICHED"/*.parquet; do
        [ -f "$f" ] || continue
        fname=$(basename "$f")
        info=$(python3 -c "
import pyarrow.parquet as pq, os, time
tbl = pq.read_metadata('$f')
rows = tbl.num_rows
mtime = os.path.getmtime('$f')
age_h = (time.time() - mtime) / 3600
age_s = f'{age_h:.1f}h' if age_h < 24 else f'{age_h/24:.0f}j'
color = '\033[92m' if age_h < 4 else ('\033[93m' if age_h < 48 else '\033[91m')
print(f'{rows:,} barres   {color}{age_s}\033[0m')
" 2>/dev/null || echo "erreur lecture")
        printf "    %-34s  %s\n" "$fname" "$info"
    done
fi

# 5. Modèles cachés
MODEL_DIR="$ROOT/reports/paper_trading/.models"
echo ""
echo -e "  ${BOLD}Modèles cachés${NC}  ($MODEL_DIR)"
if [ ! -d "$MODEL_DIR" ] || [ -z "$(ls -A "$MODEL_DIR" 2>/dev/null)" ]; then
    echo -e "    $WARN  ${YLW}Aucun modèle — lancer: bin/retrain${NC}"
else
    for f in "$MODEL_DIR"/*.pkl; do
        [ -f "$f" ] || continue
        fname=$(basename "$f")
        age_days=$(python3 -c "
import os, time
mtime = os.path.getmtime('$f')
days = int((time.time() - mtime) / 86400)
color = '\033[92m' if days < 7 else ('\033[93m' if days < 30 else '\033[91m')
print(f'{color}{days}j\033[0m')
" 2>/dev/null || echo "?")
        printf "    %-40s  %s\n" "$fname" "$age_days"
    done
fi

# 6. State paper trading
FLEET="$ROOT/reports/paper_trading/fleet_summary.json"
echo ""
echo -e "  ${BOLD}Paper trading state${NC}"
if [ -f "$FLEET" ]; then
    python3 -c "
import json
from datetime import datetime, timezone
d = json.load(open('$FLEET'))
ts = d.get('timestamp', '')[:19]
assets = d.get('assets', [])
total_trades = sum(a.get('total_trades', 0) for a in assets)
btc_regime = d.get('btc_regime', '?')
print(f'    Dernier signal : {ts}   Régime BTC : {btc_regime}   Trades total : {total_trades}')
" 2>/dev/null || echo "    erreur lecture fleet_summary.json"
else
    echo -e "    $WARN  ${YLW}fleet_summary.json absent (aucun signal généré)${NC}"
fi

# 7. Imports Python actifs
echo ""
echo -e "  ${BOLD}Modules Python actifs${NC}"
python3 -c "
mods = [
    ('ai.level_2.trm_fleet_long_v5', 'TRMFleetLongV5'),
    ('ai.level_0.alpha_features', 'compute_alpha_features'),
    ('ai.level_0.labels', 'build_labels'),
    ('ai.meta.suppressor', 'MetaSuppressor'),
    ('risk.kill_switch', 'KillSwitch'),
    ('risk.dynamic_sizing', 'DynamicSizer'),
    ('config.deployment_status', 'PAPER_ENABLED'),
    ('data_pipeline.enriched_ohlcv_features', 'compute_enriched_ohlcv_features'),
]
import sys, os
sys.path.insert(0, '.')
ok = 0; fail = 0
for mod, sym in mods:
    try:
        m = __import__(mod, fromlist=[sym])
        getattr(m, sym)
        print(f'    \033[92m✓\033[0m  {mod}')
        ok += 1
    except Exception as e:
        print(f'    \033[91m✗\033[0m  {mod}  →  {e}')
        fail += 1
print(f'\n    {ok} OK, {fail} erreurs')
sys.exit(fail)
" 2>&1 || ((errors++)) || true

echo ""
if [ "$errors" -eq 0 ]; then
    echo -e "${GRN}  ✓ Système opérationnel${NC}\n"
else
    echo -e "${RED}  ✗ $errors problème(s) détecté(s) — voir ci-dessus${NC}\n"
    exit 1
fi
