#!/usr/bin/env bash
# bin/validate — Walk-forward validation officielle
# Usage: bin/validate [--folds 2022,2023,2024,2025] [--triple-barrier] [--max-assets 1]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

BOLD='\033[1m'; GRN='\033[0;32m'; YLW='\033[1;33m'; RED='\033[0;31m'; GRY='\033[0;37m'; NC='\033[0m'

echo -e "\n${BOLD}▶ Walk-Forward Validation (TRM Fleet LONG v5)${NC}"
echo -e "  LightGBM DART + 24 TRM + Stacking méta-LR"
echo -e "  Objectif : ROI ≥ 5%/mois | PF ≥ 1.25 | MaxDD < 5%"
echo -e "  ${GRY}Durée estimée : 10-20 min${NC}\n"

# Arguments par défaut — BTC uniquement (test propre, pas de contamination multi-asset)
ARGS="${*:---folds 2022,2023,2024,2025 --no-extra}"

echo -e "  Commande : python3 scripts/walk_forward_v5.py $ARGS\n"
echo -e "${YLW}  ⚠ Résultats validés : AUC 0.81-0.85, WR 70-80%, 0 mois négatif sur 48${NC}\n"

python3 scripts/walk_forward_v5.py $ARGS

echo -e "\n${GRN}✓ Validation terminée${NC}"
echo -e "  Résultats : reports/walk_forward_v5/results_v5.json\n"
