#!/usr/bin/env bash
# bin/status — État paper trading en temps réel
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPORTS="$ROOT/reports/paper_trading"
STATE="$ROOT/state/risk_state.json"

RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[1;33m'; BLU='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'

echo ""
echo -e "${BOLD}╔═══════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}║         ALPHA TRADING — PAPER STATUS              ║${NC}"
echo -e "${BOLD}╚═══════════════════════════════════════════════════╝${NC}"
echo -e "  $(date '+%Y-%m-%d %H:%M:%S')"
echo ""

# Fleet summary si disponible
FLEET="$REPORTS/fleet_summary.json"
if [ -f "$FLEET" ]; then
    BTC_REGIME=$(python3 -c "import json; d=json.load(open('$FLEET')); print(d.get('btc_regime','?'))" 2>/dev/null || echo "?")
    BTC_PRICE=$(python3 -c "import json; d=json.load(open('$FLEET')); print(f\"{d.get('btc_price',0):,.0f}\")" 2>/dev/null || echo "?")
    TS=$(python3 -c "import json; d=json.load(open('$FLEET')); print(d.get('timestamp','?')[:19])" 2>/dev/null || echo "?")

    if [ "$BTC_REGIME" = "BEAR" ]; then
        echo -e "  Régime BTC : ${RED}● BEAR${NC}   Prix : \$$BTC_PRICE   Dernier signal : $TS"
    elif [ "$BTC_REGIME" = "BULL" ]; then
        echo -e "  Régime BTC : ${GRN}● BULL${NC}   Prix : \$$BTC_PRICE   Dernier signal : $TS"
    else
        echo -e "  Régime BTC : ${YLW}● $BTC_REGIME${NC}   Prix : \$$BTC_PRICE   Dernier signal : $TS"
    fi
    echo ""
fi

# Par asset
echo -e "${BOLD}  Asset         Trades  WR      PF      DD       Signal          p_long  ${NC}"
echo -e "  ─────────────────────────────────────────────────────────────────────"

for DIR in "$REPORTS"/*/; do
    SYMBOL=$(basename "$DIR")
    SFILE="$DIR/state.json"
    SIGFILE="$DIR/signals.csv"
    [ -f "$SFILE" ] || continue

    TRADES=$(python3 -c "import json; d=json.load(open('$SFILE')); print(d.get('total_trades',0))" 2>/dev/null || echo 0)
    WINS=$(python3 -c "import json; d=json.load(open('$SFILE')); print(d.get('total_wins',0))" 2>/dev/null || echo 0)
    DD=$(python3 -c "import json; d=json.load(open('$SFILE')); print(f\"{d.get('max_dd_pct',0):.2f}%\")" 2>/dev/null || echo "0.00%")
    PNL=$(python3 -c "import json; d=json.load(open('$SFILE')); print(f\"{d.get('cumulative_pnl_pct',0):+.2f}%\")" 2>/dev/null || echo "+0.00%")

    if [ "$TRADES" -gt 0 ] 2>/dev/null; then
        WR=$(python3 -c "print(f'{$WINS/$TRADES*100:.0f}%')" 2>/dev/null || echo "n/a")
        GWIN=$(python3 -c "import json; d=json.load(open('$SFILE')); print(d.get('gross_win_sum',0))" 2>/dev/null || echo 0)
        GLOSS=$(python3 -c "import json; d=json.load(open('$SFILE')); print(abs(d.get('gross_loss_sum',0)))" 2>/dev/null || echo 0)
        PF=$(python3 -c "g,l=$GWIN,$GLOSS; print('∞' if l==0 else f'{g/l:.2f}')" 2>/dev/null || echo "n/a")
    else
        WR="—"; PF="—"
    fi

    # Dernier signal
    if [ -f "$SIGFILE" ]; then
        LAST=$(tail -1 "$SIGFILE" 2>/dev/null)
        ACTION=$(echo "$LAST" | cut -d',' -f3 2>/dev/null || echo "?")
        PLONG=$(echo "$LAST" | cut -d',' -f4 2>/dev/null || echo "?")
    else
        ACTION="—"; PLONG="—"
    fi

    if [ "$ACTION" = "LONG" ]; then
        SIGNAL_COL="${GRN}LONG${NC}"
    elif [ "$ACTION" = "NO_SIGNAL" ]; then
        SIGNAL_COL="${YLW}NO_SIGNAL${NC}"
    else
        SIGNAL_COL="$ACTION"
    fi

    printf "  %-12s  %6s  %-6s  %-6s  %-8s  " "$SYMBOL" "$TRADES" "$WR" "$PF" "$DD"
    echo -e "${SIGNAL_COL}  $PLONG"
done

echo ""

# KillSwitch state
if [ -f "$STATE" ]; then
    TOTAL_TRADES=$(python3 -c "import json; d=json.load(open('$STATE')); print(d.get('total_trades',0))" 2>/dev/null || echo 0)
    EQUITY=$(python3 -c "import json; d=json.load(open('$STATE')); print(f\"{d.get('equity',10000):,.0f}\")" 2>/dev/null || echo "?")
    COOLDOWN=$(python3 -c "import json; d=json.load(open('$STATE')); print(d.get('cooldown_until') or 'None')" 2>/dev/null || echo "None")
    echo -e "  ${BOLD}Risk State${NC}  Equity : \$$EQUITY   Total trades : $TOTAL_TRADES   Cooldown : $COOLDOWN"
fi

echo ""
echo -e "  ${BOLD}Gates paper${NC}  90j | 100 trades | PF>1.30 | DD<3%"

# Calcul jours depuis start
if [ -f "$REPORTS/BTCUSDT/state.json" ]; then
    START=$(python3 -c "import json; d=json.load(open('$REPORTS/BTCUSDT/state.json')); print(d.get('start_date','')[:10])" 2>/dev/null || echo "?")
    if [ "$START" != "?" ]; then
        DAYS=$(python3 -c "from datetime import date; s=date.fromisoformat('$START'); print((date.today()-s).days)" 2>/dev/null || echo "?")
        echo -e "  Durée : ${YLW}$DAYS / 90 jours${NC}   Depuis $START"
    fi
fi

echo ""
