# ── Données volumineuses ─────────────────────────────────────────────────────
# `data/*` (not `data/`) so the exceptions below can re-include specific
# subdirectories -- a directory-level ignore (`data/`) makes git skip
# descending into it entirely, and a `!` negation can't undo that (git
# docs: "not possible to re-include content if a parent directory of that
# content is excluded").
data/*
datasets/
ML-DL/
# Phase 4D exceptions: small, curated, non-market-data files that belong in
# version control -- the real ProductSpec registry (a few KB, extracted from
# venue exchangeInfo, not a fetched market data blob) and its provenance
# manifests (Phase 4D commit 7 -- hashes/schema/row-counts, never the actual
# klines/funding/enriched parquet files themselves).
!data/venue_specs
!data/manifests

# data_v2/ (Data V2 rebuild) -- same policy: build code is tracked, the
# generated parquet lakes and per-symbol progress manifests are not.
data_v2/normalized/**/venue=*/
data_v2/normalized/**/manifest.json

# ── État d'approbation de déploiement, propre à chaque machine ──────────────
# (src/alpha20/deployment_guard.py) — jamais une vérité partagée entre Mac et
# qbee, jamais committé.
configs/DEPLOYMENT_MANIFEST.json

# ── Artefacts ML / checkpoints ────────────────────────────────────────────────
training_output_corrected/
ai/models/.venv/
ai/cache/
ai/models/runs/
ai/checkpoints/
ai/checkpoints_light/
ai/models/level_*/checkpoints/
ai/models/level_*/__pycache__/

# ── Artefacts trading-system ─────────────────────────────────────────────────
trading-system/artifacts/
trading-system/.venv/
trading-system/__pycache__/

# ── Fichiers de données lourds (toutes extensions) ───────────────────────────
*.csv
*.csv.gz
*.parquet

# ── Exception : livrables CSV des campagnes edge_discovery ───────────────────
# `*.csv` est volontairement global (données lourdes), mais il emportait aussi
# les LIVRABLES d'analyse des workers : tables de verdicts, audits de colonnes,
# grilles de résultats. Constaté le 2026-09-05 sur le round 4 — 18 fichiers,
# 1,7 Mo, dont l'audit des 4 178 colonnes de data/enriched, qui n'auraient
# jamais été commités et auraient disparu au premier nettoyage. Ce sont des
# résultats, pas de la donnée : ils doivent survivre à leur worker.
!reports/edge_discovery/**/*.csv
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
# exception to the blanket *.parquet rule above -- small (~20KB), curated,
# same rationale as data/venue_specs: a reviewable Data V2 PIT fact table,
# not a fetched market-data blob (must come after the *.parquet rule --
# gitignore negations only override rules earlier in the file).
!data_v2/instruments/instrument_master.parquet
*.pt
*.pth
*.onnx
*.ckpt
*.bin
*.npy
*.npz
*.zip
*.gz
*.tar
*.tar.gz
*.7z
*.rar
*.db
*.sqlite
*.sqlite3

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Système ───────────────────────────────────────────────────────────────────
.DS_Store
.env
*.log
.vscode/settings.json
data/derivatives_raw/
data/derivatives_live/
reports/derivatives_collector.log
reports/DERIVATIVES_DAILY_*.md
reports/paper_live/
reports/paper_v1.log
data/derivatives_backfill/
data/events/
reports/parallel_50/enriched_backfill.log
reports/parallel_50/parallel_50_backtest.log
reports/parallel_50/pullback_train.log
reports/parallel_50/parallel_50_ranked.log
reports/parallel_50/parallel_50_edge.log
data/news_raw/
data/news_backfill/
data/worldmon_jsonl/
data/worldmon_features/

# ── Command Center : credentials hachés + secret de session (jamais committés) ──
configs/command_center_users.json
state/command_center_secret

# Verrou du labelliseur de résultats forward (scripts/label_forward_outcomes.py)
reports/live_alpha_lab/.outcome_label.lock

# Manifeste de sauvegarde : régénéré par scripts/backup_critical_state.py --manifest
reports/ops/BACKUP_MANIFEST.json
