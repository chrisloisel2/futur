# Local MongoDB
FUTUR_MONGO_URI=mongodb://localhost:27017
FUTUR_MONGO_DB=trader
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=trader
FUTUR_MONGO_SOURCE_COLLECTION=historical_ohlcv
FUTUR_MONGO_FEATURE_COLLECTION=historical_ohlcv_enriched
MONGODB_FEATURE_COLLECTION=historical_ohlcv_enriched
MONGODB_HIST_COLLECTION=historical_ohlcv_enriched

# Unified local stack launcher
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN_REGEX=https?://.*:3000

# MarketIntel collectors and Scrapy pipelines
MONGO_URI=mongodb://localhost:27017
MONGO_DB=market_intel
MONGO_DATABASE=market_intel
MONGO_COLLECTION=signals

# Proxy store used by scrapers. It can be empty; collectors will run without a proxy.
PROXY_MONGO_URI=mongodb://localhost:27017
PROXY_MONGO_DB=proxy_db
PROXY_COLLECTION=proxies
PROXY_REFRESH_INTERVAL=300

# Whale/blockchain pipelines
WHALE_MONGODB_URI=mongodb://localhost:27017
WHALE_MONGODB_DATABASE=whale_data
BLOCKCHAIN_MONGODB_URI=mongodb://localhost:27017
BLOCKCHAIN_MONGODB_DATABASE=whale_data

# Vector context store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=market_context_v1
CONTEXT_EMBEDDING_MODEL=BAAI/bge-small-en
