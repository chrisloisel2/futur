# 1. Copiez ce fichier en .env dans le dossier trading-system/
#    cp .env.example .env
# 2. Remplissez vos clés API Binance
# 3. Ne commitez JAMAIS le fichier .env (il est dans .gitignore)
#
# Pour obtenir vos clés API Binance :
#   https://www.binance.com/fr/my/settings/api-management
#
# Permissions nécessaires (et seulement celles-ci) :
#   ✓ Enable Reading
#   ✓ Enable Spot & Margin Trading
#   ✗ Enable Withdrawals  ← NE PAS COCHER
#
# Pour tester sans risque, utilisez le testnet :
#   https://testnet.binance.vision/
#   python scripts/run_live_minimal.py --testnet --dry-run
# ─────────────────────────────────────────────────────────────────────────────

BINANCE_API_KEY=votre_cle_api_ici
BINANCE_API_SECRET=votre_secret_api_ici
