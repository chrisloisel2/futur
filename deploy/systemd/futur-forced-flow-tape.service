[Unit]
Description=Futur P2B forced-flow tape (liquidations binance/bybit + BBO/mark/index/funding before the event; no depth, no trading)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/home/qbee/futur
ExecStart=/home/qbee/futur/.venv/bin/python -m data_lake.collectors.forced_flow_tape --disk-budget-gb 4 --min-free-disk-gb 15
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:/home/qbee/futur/reports/forced_flow/collector.log
StandardError=append:/home/qbee/futur/reports/forced_flow/collector.log
[Install]
WantedBy=default.target
